+/* Apply the IW620 128-byte DMA minimum, while the interface
+ * header and TxPD retain their real lengths. Do not round larger packets.
+ */
+static t_u32 wlan_iw620_tx_dma_len(mlan_adapter *pmadapter, t_u32 len)
+{
+	if (len < ADMA_MIN_PKT_SIZE &&
+	    pmadapter->card_type == CARD_TYPE_PCIE9097 &&
+	    pmadapter->pcard_pcie->reg->use_adma)
+		return ADMA_MIN_PKT_SIZE;
+	return len;
+}
+
+/* Completion and teardown must unmap the same address and length we mapped. */
+static mlan_status wlan_pcie_unmap_tx_buf(mlan_adapter *pmadapter,
+					 mlan_buffer *pmbuf, t_u32 slot)
+{
+	pmlan_callbacks pcb = &pmadapter->callbacks;
+	t_u8 *bounce = pmadapter->pcard_pcie->tx_bounce_buf[slot];
+	mlan_status ret = pcb->moal_unmap_memory(
+		pmadapter->pmoal_handle,
+		bounce ? bounce : pmbuf->pbuf + pmbuf->data_offset,
+		pmbuf->buf_pa, bounce ? ADMA_MIN_PKT_SIZE : pmbuf->data_len,
+		PCI_DMA_TODEVICE);
+
+	if (ret == MLAN_STATUS_SUCCESS && bounce) {
+		pcb->moal_mfree(pmadapter->pmoal_handle, bounce);
+		pmadapter->pcard_pcie->tx_bounce_buf[slot] = MNULL;
+	}
+	return ret;
+}
