From: PS5 Linux Kernel Team <kernel@ps5-linux.local>
Subject: [PATCH 6/12] iw620: kernel 6.x vs 7.x cfg80211 and timer API compatibility

Wrap callback signatures in #if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
so Linux 6.x keeps struct net_device * while Kernel >= 7.1.0 takes
struct wireless_dev *wdev. Include Kernel 7.2 string compat and Kernel 7.3
mgmt TX cookie handling.

Signed-off-by: PS5 Linux Kernel Team <kernel@ps5-linux.local>
---
diff --git a/mlinux/moal_cfg80211.c b/mlinux/moal_cfg80211.c
index 207e671..d62b301 100644
--- a/mlinux/moal_cfg80211.c
+++ b/mlinux/moal_cfg80211.c
@@ -1806,7 +1806,11 @@ fail:
  * @return              0 -- success, otherwise fail
  */
 #endif
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+int woal_cfg80211_add_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+#else
 int woal_cfg80211_add_key(struct wiphy *wiphy, struct net_device *netdev,
+#endif
 #if ((KERNEL_VERSION(6, 1, 0) <= LINUX_VERSION_CODE) ||                        \
      (defined(ANDROID_SDK_VERSION) && ANDROID_SDK_VERSION >= 33))
 			  int link_id,
@@ -1817,6 +1821,9 @@ int woal_cfg80211_add_key(struct wiphy *wiphy, struct net_device *netdev,
 #endif
 			  const t_u8 *mac_addr, struct key_params *params)
 {
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+	struct net_device *netdev = wdev->netdev;
+#endif
 	moal_private *priv = (moal_private *)woal_get_netdev_priv(netdev);
 	t_u8 pairwise_key = MFALSE;
 
@@ -1883,7 +1890,11 @@ int woal_cfg80211_add_key(struct wiphy *wiphy, struct net_device *netdev,
  * @return              0 -- success, otherwise fail
  */
 #endif
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+int woal_cfg80211_del_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+#else
 int woal_cfg80211_del_key(struct wiphy *wiphy, struct net_device *netdev,
+#endif
 #if ((KERNEL_VERSION(6, 1, 0) <= LINUX_VERSION_CODE) ||                        \
      (defined(ANDROID_SDK_VERSION) && ANDROID_SDK_VERSION >= 33))
 			  int link_id,
@@ -1894,6 +1905,9 @@ int woal_cfg80211_del_key(struct wiphy *wiphy, struct net_device *netdev,
 #endif
 			  const t_u8 *mac_addr)
 {
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+	struct net_device *netdev = wdev->netdev;
+#endif
 	moal_private *priv = (moal_private *)woal_get_netdev_priv(netdev);
 
 	ENTER();
@@ -1979,7 +1993,11 @@ int woal_cfg80211_set_default_key(struct wiphy *wiphy,
 
 #if KERNEL_VERSION(2, 6, 30) <= CFG80211_VERSION_CODE
 int woal_cfg80211_set_default_mgmt_key(struct wiphy *wiphy,
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+				       struct wireless_dev *wdev,
+#else
 				       struct net_device *netdev,
+#endif
 #if ((KERNEL_VERSION(6, 1, 0) <= LINUX_VERSION_CODE) ||                        \
      (defined(ANDROID_SDK_VERSION) && ANDROID_SDK_VERSION >= 33))
 				       int link_id,
@@ -1994,6 +2012,10 @@ int woal_cfg80211_set_default_mgmt_key(struct wiphy *wiphy,
 
 #if KERNEL_VERSION(5, 10, 0) <= CFG80211_VERSION_CODE
 int woal_cfg80211_set_default_beacon_key(struct wiphy *wiphy,
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+					 struct wireless_dev *wdev,
+#else
 					 struct net_device *netdev,
+#endif
 #if ((KERNEL_VERSION(6, 1, 0) <= LINUX_VERSION_CODE) ||                        \
 					 int link_id,
diff --git a/mlinux/moal_cfg80211.h b/mlinux/moal_cfg80211.h
index 7e98c49..7614477 100644
--- a/mlinux/moal_cfg80211.h
+++ b/mlinux/moal_cfg80211.h
@@ -152,7 +152,11 @@ int woal_cfg80211_set_wiphy_params(struct wiphy *wiphy,
 #endif
 				   u32 changed);
 
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+int woal_cfg80211_add_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+#else
 int woal_cfg80211_add_key(struct wiphy *wiphy, struct net_device *dev,
+#endif
 #if ((KERNEL_VERSION(6, 1, 0) <= LINUX_VERSION_CODE) ||                        \
      (defined(ANDROID_SDK_VERSION) && ANDROID_SDK_VERSION >= 33))
 			  int link_id,
@@ -163,7 +167,11 @@ int woal_cfg80211_add_key(struct wiphy *wiphy, struct net_device *dev,
 #endif
 			  const t_u8 *mac_addr, struct key_params *params);
 
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+int woal_cfg80211_del_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+#else
 int woal_cfg80211_del_key(struct wiphy *wiphy, struct net_device *dev,
+#endif
 #if ((KERNEL_VERSION(6, 1, 0) <= LINUX_VERSION_CODE) ||                        \
      (defined(ANDROID_SDK_VERSION) && ANDROID_SDK_VERSION >= 33))
 			  int link_id,
@@ -263,7 +271,11 @@ int woal_cfg80211_set_default_key(struct wiphy *wiphy, struct net_device *dev,
 
 #if KERNEL_VERSION(2, 6, 30) <= CFG80211_VERSION_CODE
 int woal_cfg80211_set_default_mgmt_key(struct wiphy *wiphy,
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+				       struct wireless_dev *wdev,
+#else
 				       struct net_device *dev,
+#endif
 #if ((KERNEL_VERSION(6, 1, 0) <= LINUX_VERSION_CODE) ||                        \
      (defined(ANDROID_SDK_VERSION) && ANDROID_SDK_VERSION >= 33))
 				       int link_id,
@@ -273,6 +285,10 @@ int woal_cfg80211_set_default_mgmt_key(struct wiphy *wiphy,
 
 #if KERNEL_VERSION(5, 10, 0) <= CFG80211_VERSION_CODE
 int woal_cfg80211_set_default_beacon_key(struct wiphy *wiphy,
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+					 struct wireless_dev *wdev,
+#else
 					 struct net_device *dev,
+#endif
 #if ((KERNEL_VERSION(6, 1, 0) <= LINUX_VERSION_CODE) ||                        \
 					 int link_id,
@@ -503,7 +519,11 @@ int woal_cfg80211_del_beacon(struct wiphy *wiphy, struct net_device *dev,
 #else
 int woal_cfg80211_del_beacon(struct wiphy *wiphy, struct net_device *dev);
 #endif
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+int woal_cfg80211_del_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+#else
 int woal_cfg80211_del_station(struct wiphy *wiphy, struct net_device *dev,
+#endif
 #if KERNEL_VERSION(3, 19, 0) <= CFG80211_VERSION_CODE
 			      struct station_del_parameters *param);
 #else
diff --git a/mlinux/moal_shim.c b/mlinux/moal_shim.c
index 181c4f2..9ee4af8 100644
--- a/mlinux/moal_shim.c
+++ b/mlinux/moal_shim.c
@@ -5038,7 +5038,11 @@ mlan_status moal_recv_event(t_void *pmoal, pmlan_event pmevent)
 				}
 #endif /* KERNEL_VERSION */
 				if (priv->netdev && priv->wdev)
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+					cfg80211_new_sta(priv->wdev,
+#else
 					cfg80211_new_sta(priv->netdev,
+#endif
 							 (t_u8 *)addr, sinfo,
 							 GFP_KERNEL);
 				kfree(sinfo);
@@ -5101,7 +5105,11 @@ mlan_status moal_recv_event(t_void *pmoal, pmlan_event pmevent)
 			} else
 #endif
 				if (priv->netdev && priv->wdev)
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+				cfg80211_del_sta(priv->wdev,
+#else
 				cfg80211_del_sta(priv->netdev,
+#endif
 						 pmevent->event_buf + 2,
 						 GFP_KERNEL);
 
diff --git a/mlinux/moal_sta_cfg80211.c b/mlinux/moal_sta_cfg80211.c
index a797af9..6ceff98 100644
--- a/mlinux/moal_sta_cfg80211.c
+++ b/mlinux/moal_sta_cfg80211.c
@@ -180,7 +180,11 @@ static int woal_cfg80211_disconnect(struct wiphy *wiphy, struct net_device *dev,
 				    t_u16 reason_code);
 
 static int woal_cfg80211_get_station(struct wiphy *wiphy,
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+				     struct wireless_dev *wdev,
+#else
 				     struct net_device *dev,
+#endif
 #if CFG80211_VERSION_CODE >= KERNEL_VERSION(3, 16, 0)
 				     const u8 *mac,
 #else
@@ -189,7 +193,11 @@ static int woal_cfg80211_get_station(struct wiphy *wiphy,
 				     struct station_info *sinfo);
 
 static int woal_cfg80211_dump_station(struct wiphy *wiphy,
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+				      struct wireless_dev *wdev, int idx,
+#else
 				      struct net_device *dev, int idx,
+#endif
 				      t_u8 *mac, struct station_info *sinfo);
 
 static int woal_cfg80211_dump_survey(struct wiphy *wiphy,
@@ -339,7 +347,11 @@ void woal_cfg80211_tdls_cancel_channel_switch(struct wiphy *wiphy,
 #endif
 #if CFG80211_VERSION_CODE >= KERNEL_VERSION(3, 2, 0)
 static int woal_cfg80211_change_station(struct wiphy *wiphy,
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+					struct wireless_dev *wdev,
+#else
 					struct net_device *dev,
+#endif
 #if CFG80211_VERSION_CODE >= KERNEL_VERSION(3, 16, 0)
 					const u8 *mac,
 #else
@@ -376,7 +388,11 @@ int woal_cfg80211_uap_add_station(struct wiphy *wiphy, struct net_device *dev,
 #if CFG80211_VERSION_CODE >= KERNEL_VERSION(3, 2, 0)
 #ifdef UAP_SUPPORT
 static int woal_cfg80211_add_station(struct wiphy *wiphy,
+#if KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE
+				     struct wireless_dev *wdev,
+#else
 				     struct net_device *dev,
+#endif
 #if CFG80211_VERSION_CODE >= KERNEL_VERSION(3, 16, 0)
 				     const u8 *mac,
 #else
