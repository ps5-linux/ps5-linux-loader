diff --git a/mlan/mlan_11ax.c b/mlan/mlan_11ax.c
--- a/mlan/mlan_11ax.c
+++ b/mlan/mlan_11ax.c
@@ -30,6 +30,52 @@
 #include "mlan_11n.h"
 #include "mlan_11ax.h"
 #include "mlan_11ac.h"
+
+#ifdef PCIE9097
+/* Match the incomplete HE TLV before changing its length or PPE fields. */
+static t_u32 wlan_iw620_he_profile(t_u8 *tlv, t_u32 total, t_u32 capacity)
+{
+	static const t_u8 fw_5g[22] = {
+		0x23, 0x01, 0x00, 0x00, 0x82, 0x00, 0x08,
+		0x04, 0x70, 0x7e, 0xc9, 0xfd, 0x01, 0xa0, 0x0e,
+		0x01, 0x3d, 0x00, 0xfa, 0xff, 0xfa, 0xff
+	};
+	/* Corrected 5 GHz STA profile, including its four PPE bytes. */
+	static const t_u8 fixed_5g[26] = {
+		0x23, 0x00, 0x00, 0x00, 0x82, 0x00, 0x08,
+		0x04, 0x70, 0x7e, 0xc9, 0xfd, 0x01, 0xa0, 0x0a,
+		0x03, 0x3d, 0x00, 0xfa, 0xff, 0xfa, 0xff,
+		0xe1, 0xff, 0xc7, 0x71
+	};
+	t_u32 i;
+	t_bool is_2g;
+
+	if (!tlv || total != 26 || capacity < total ||
+	    tlv[0] != 0xff || tlv[1] || tlv[2] != 22 || tlv[3])
+		return 0;
+	is_2g = tlv[11] == 0x02;
+	for (i = 0; i < sizeof(fw_5g); i++) {
+		t_u8 expected = fw_5g[i];
+		if (is_2g && i == 7)
+			expected = 0x02;
+		if (is_2g && i == 15)
+			expected = 0x03;
+		if (tlv[4 + i] != expected)
+			return 0;
+	}
+	if (!is_2g) {
+		if (capacity < 30)
+			return 0;
+		for (i = 0; i < sizeof(fixed_5g); i++)
+			tlv[4 + i] = fixed_5g[i];
+		tlv[2] = sizeof(fixed_5g);
+		return 30;
+	}
+	/* No 2 GHz PPE bytes exist: keep association and cfg80211 consistent. */
+	tlv[17] &= ~0x80;
+	return 26;
+}
+#endif
 
